<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMauiApp.MainPage"
             Title="BMI Calculator">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18">

            <Label
                Text="BMI Calculator"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Enter your weight and height to calculate your body mass index."
                HorizontalTextAlignment="Center"
                SemanticProperties.Description="Instructions for entering weight and height" />

            <Label Text="Weight (lb)" FontAttributes="Bold" />

            <Entry
                x:Name="WeightEntry"
                Placeholder="Example: 154"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                ReturnType="Next" />

            <Label Text="Height (cm)" FontAttributes="Bold" />

            <Entry
                x:Name="HeightEntry"
                Placeholder="Example: 175"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                ReturnType="Done" />

            <Button
                Text="Calculate BMI"
                Clicked="OnCalculateClicked"
                SemanticProperties.Hint="Calculates BMI from the entered weight and height" />

            <Button
                Text="Clear"
                Clicked="OnClearClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}" />

            <Border
                Padding="20"
                Margin="0,10,0,0"
                Stroke="{StaticResource Primary}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Your BMI"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="ResultLabel"
                        Text="--"
                        FontSize="42"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="CategoryLabel"
                        Text="Enter your details above"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="BMI categories: Underweight below 18.5, healthy weight 18.5–24.9, overweight 25–29.9, obesity 30 or higher."
                FontSize="12"
                TextColor="{StaticResource Gray500}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>